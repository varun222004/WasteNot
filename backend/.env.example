# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development                # development | production

MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=wastenot

# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
OTP_PEPPER=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cookies. Production needs COOKIE_SECURE=true. Keep SAMESITE=lax by serving the API from the same origin as the site.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Development only: echo the sign-in code in the API response instead of emailing it. Refused in production.
DEV_OTP_ENABLED=true
EMAIL_PROVIDER=console                 # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

UPLOAD_STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
UPLOAD_STORAGE_PREFIX=wastenot

# Comma-separated emails that become admins when they sign in. Production: your own address only.
ADMIN_EMAILS=
FOOD_SHARING_ENABLED=true
SWEEP_INTERVAL_SECONDS=60
